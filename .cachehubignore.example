# .cachehubignore — CacheHub ignore rules example
# Place this file in your project root to customize which files CacheHub ignores.
# Rules are merged with: system defaults > .gitignore > .cachehubignore > user rules
# Syntax is similar to .gitignore: one pattern per line, # for comments.

# Build outputs
bin/
obj/
dist/
build/
target/
out/

# Dependencies
node_modules/
vendor/
__pycache__/
.venv/
venv/

# IDE files
.vs/
.vscode/
.idea/
*.user
*.suo

# OS files
Thumbs.db
Desktop.ini
.DS_Store

# Logs
*.log
logs/

# CacheHub internal
.cachehub/

# Large binary files
*.exe
*.dll
*.so
*.dylib
*.pdb
*.apk

# Media (not useful for code context)
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.ico
*.webp
*.mp3
*.mp4
*.avi
*.mov

# Archives
*.zip
*.gz
*.tar
*.bz2
*.7z
*.rar

# Lock files (context not useful)
package-lock.json
yarn.lock
pnpm-lock.yaml
