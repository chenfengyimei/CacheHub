<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors>nullable</WarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>false</ContinuousIntegrationBuild>
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!--
      NU1903 (NuGet vulnerability warning) is suppressed globally.
      Accepted risk: Microsoft.Bcl.Memory (transitive from Microsoft.Data.Sqlite 10.0.0)
      has advisory GHSA-73j8-2gch-69rq with no fixed version available as of 2026-08-08.
      SQLitePCLRaw upgraded to 3.0.0 to resolve its vulnerability (GHSA-2m69-gcr7-jv3q).
      When a patched Microsoft.Bcl.Memory is released, remove this suppression.
    -->
    <NoWarn>$(NoWarn);CS1591;NU1903</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>CacheHub Contributors</Authors>
    <Product>CacheHub</Product>
    <Copyright>Copyright (c) 2026 CacheHub Contributors</Copyright>
    <Version>0.2.0-prealpha</Version>
  </PropertyGroup>

</Project>
